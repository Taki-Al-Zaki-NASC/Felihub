# Pooled connection — used by the app at runtime on serverless.
DATABASE_URL="postgresql://user:pass@host/db?pgbouncer=true&connection_limit=1"
# Direct connection — used by `prisma migrate`, which needs a real session.
DIRECT_URL="postgresql://user:pass@host/db"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Realtime transport. Socket.io cannot run on Vercel (no persistent process),
# so this is the free-tier substitute pending your decision — see README.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
