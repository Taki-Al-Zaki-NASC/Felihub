# A TEMPLATE. Never put real values in this file — it is committed, and on a
# public repository that means world-readable. Copy it to .env.local (which is
# git-ignored) and fill that in, or set the values in your host's dashboard.

# ── Database ────────────────────────────────────────────────────────────────
# Copy both from Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL is the app's runtime connection and must be the *Transaction
# pooler* (port 6543). The query parameters are not optional: a transaction-mode
# pooler rejects prepared statements, and Prisma only stops using them when the
# URL says pgbouncer=true. Without connection_limit=1, serverless functions
# exhaust the pool.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL is used by `prisma db push` and migrations, which need a real
# session. Use the *Session pooler* (port 5432) — it is reachable over IPv4.
# The "Direct connection" host, db.PROJECT_REF.supabase.co, is IPv6-only on
# newer projects and unreachable from most serverless and CI platforms.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Note the username format: the pooler hosts want `postgres.PROJECT_REF`, while
# db.PROJECT_REF.supabase.co wants plain `postgres`. Mixing them up fails
# authentication. If the password contains @ : / ? or #, URL-encode it.

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs the session cookie. At least 32 characters, and genuinely random —
# `openssl rand -base64 32`. Anyone who knows this value can mint a session for
# any account, so it never belongs in a committed file.
AUTH_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Realtime ────────────────────────────────────────────────────────────────
# Socket.io cannot run on Vercel (no persistent process), so this is the
# free-tier substitute pending that decision — see README. The anon key is
# designed to be public; the database password above is not.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
