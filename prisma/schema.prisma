// Felicek — the business model as data.
//
// Two invariants drive most of this file and must survive any refactor:
//
//   1. An account is usable only when identity is on file AND the deposit has
//      cleared. Both, for every role. There is no "skip for now".
//   2. Money is never marked received by the party who owes it. Only the
//      payment webhook writes PaymentIntent.status = PAID, and only a PAID
//      intent can flip a deposit. That is what makes escrow mean anything.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Serverless opens a connection per invocation; the pooled URL is what
  // stops Postgres running out of them. directUrl is used for migrations,
  // which need a real session.
  directUrl = env("DIRECT_URL")
}

enum Role {
  FREELANCER
  CLIENT
  AGENCY
  STARTUP
}

enum KycStage {
  NONE
  ID_SUBMITTED
  VERIFIED
}

enum JobStatus {
  OPEN
  FILLED
  CLOSED
}

enum ProposalStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  DECLINED
  WITHDRAWN
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum DepositKind {
  TRUST_BOND      // freelancer, refundable after the first completed job
  POSTING_BALANCE // hirer, spent into escrow rather than consumed
}

enum LedgerKind {
  DEPOSIT
  ESCROW_HOLD
  ESCROW_RELEASE
  PLATFORM_FEE
  GATEWAY_FEE
  PAYOUT
  REFUND
  PLEDGE
  PLEDGE_RELEASE
}

enum RaiseStatus {
  DRAFT
  OPEN
  FUNDED    // hit its goal; the money has moved to the founder
  EXPIRED   // deadline passed under goal; every pledge refunded
  CANCELLED // withdrawn by the founder, which also refunds
}

enum PledgeStatus {
  HELD      // committed, sitting in escrow, not the founder's yet
  RELEASED  // the raise succeeded and the money moved
  REFUNDED  // the raise failed, expired or was cancelled
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  displayName   String
  role          Role
  passwordHash  String?
  image         String?

  // Verification. `isVerified` is deliberately NOT a stored column: it is
  // derived (see server/services/verification.ts) so it cannot drift out of
  // agreement with the three fields that define it, which is exactly the bug
  // that shipped in v1.
  idSubmitted   Boolean  @default(false)
  kycStage      KycStage @default(NONE)
  depositPaid   Boolean  @default(false)
  depositCents  Int      @default(0)
  depositKind   DepositKind?
  depositReleased Boolean @default(false)

  // Money, in cents. Never floats — a rounding error here is someone's wages.
  walletBalanceCents Int @default(0)
  postingBalanceCents Int @default(0)
  totalEarnedCents   Int @default(0)

  profile       Profile?
  jobs          Job[]        @relation("JobOwner")
  proposals     Proposal[]
  ledger        LedgerEntry[]
  paymentIntents PaymentIntent[]
  reviewsWritten Review[]    @relation("ReviewAuthor")
  reviewsAbout   Review[]    @relation("ReviewSubject")
  raises        Raise[]      @relation("RaiseFounder")
  pledges       Pledge[]     @relation("PledgeBacker")
  memberships   ThreadMember[]
  messages      Message[]
  notifications Notification[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline     String?
  bio          String?  @db.Text
  location     String?
  // The same taxonomy jobs are posted under, so "does this job suit this
  // freelancer" is a comparison rather than a guess.
  category     String?
  hourlyRateCents Int?
  skills       String[]
  languages    String[]
  portfolioUrl String?
  experience   Json?    // ExperienceEntry[] — validated by Zod on write

  // Mirrors the derived verification state for fast public reads. Written
  // only by the server, never by the account it describes.
  verified     Boolean  @default(false)
  ratingAvg    Float?
  ratingCount  Int      @default(0)

  updatedAt    DateTime @updatedAt

  @@index([verified])
  @@index([category])
}

model Job {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation("JobOwner", fields: [ownerId], references: [id])

  title         String
  description   String    @db.Text
  category      String
  skills        String[]
  budgetCents   Int?
  // Expected calendar duration, as advertised by the client. Distinct from a
  // proposal's `timelineDays`, which is what a freelancer offers back.
  durationDays  Int?
  status        JobStatus @default(OPEN)

  hiredProposalId String? @unique
  escrowHeldCents Int     @default(0)
  proposalsCount  Int     @default(0)
  views           Int     @default(0)

  milestones    Milestone[]
  proposals     Proposal[]
  challenge     Challenge?
  threads       Thread[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([ownerId, createdAt])
  @@index([category, status])
}

model Milestone {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int

  // Funded and released are two separate facts. Money moves into escrow when
  // the client funds a milestone and out of it when they release — a single
  // "paid" flag would make it impossible to tell "the money is committed" from
  // "the money has been handed over", which is the distinction escrow exists
  // for.
  funded      Boolean  @default(false)
  fundedAt    DateTime?
  released    Boolean  @default(false)
  releasedAt  DateTime?
  position    Int

  @@index([jobId, position])
}

model Proposal {
  id             String         @id @default(cuid())
  jobId          String
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId   String
  freelancer     User           @relation(fields: [freelancerId], references: [id])

  // ── Private to the bidder and the job's owner. Never selected for anyone
  //    else; see server/services/proposals.ts, which is the only module that
  //    reads this table.
  bidCents       Int
  note           String         @db.Text     // the cover letter
  timelineDays   Int?                        // proposed delivery time
  attachmentUrl  String?                     // portfolio piece, sample, brief
  // ────────────────────────────────────────────────────────────────────────

  status         ProposalStatus @default(SUBMITTED)

  // The owner-visible summary. The full submission lives in ChallengeAnswer
  // and is never joined into a client-facing query.
  answerPreview  String?
  score          Int?

  // How many times this bid has been edited after first submission. Two is
  // the limit: revising once is a correction, revising ten times is bidding
  // against yourself while everyone watches.
  revisions      Int            @default(0)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  answers        ChallengeAnswer[]

  // One bid per person per job. Re-submitting edits rather than stacking.
  @@unique([jobId, freelancerId])
  @@index([freelancerId, createdAt])
  @@index([jobId, status])
}

model Challenge {
  id        String  @id @default(cuid())
  jobId     String  @unique
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // "QUIZ" — multiple choice, graded automatically.
  // "WRITTEN" — a prompt, read by the owner.
  // "LIVE" — a scheduled interview, held over the call in the thread.
  mode      String
  prompt    String? @db.Text
  questions Json?   // [{ prompt, options }] — options public, key is not

  // Two attempts. One is unforgiving of a misread question; unlimited makes
  // the score meaningless because it converges on the answer key.
  maxAttempts Int   @default(2)
  timeLimitMins Int?

  // LIVE only: when the interview is held.
  scheduledAt DateTime?

  // The answer key. Selected only by the job owner's own queries; never
  // included in any payload sent to an applicant.
  answerKey Json?

  answers   ChallengeAnswer[]
}

model ChallengeAnswer {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  proposalId  String
  proposal    Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  // 1 or 2. Kept as separate rows rather than overwriting, so a second attempt
  // cannot quietly erase the evidence of the first.
  attempt     Int       @default(1)
  scorePct    Int?

  // The freelancer's full work. Readable by its author, and by nobody else —
  // enforced in server/services, which is the only place this table is read.
  fullAnswer  String?   @db.Text
  picks       Int[]
  submittedAt DateTime  @default(now())

  @@unique([proposalId, attempt])
  @@index([challengeId])
}

model PaymentIntent {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  purpose     String        // "DEPOSIT" | "TOPUP"
  amountCents Int
  status      PaymentStatus @default(PENDING)
  gatewayRef  String?       @unique

  createdAt   DateTime      @default(now())
  paidAt      DateTime?

  @@index([userId, status])
}

model LedgerEntry {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  kind        LedgerKind
  // Negative for fees and payouts, positive for credits. The platform fee and
  // the gateway fee are separate rows on purpose: blending them is how a
  // marketplace that advertises 1% quietly charges four.
  amountCents Int
  label       String
  jobId       String?
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
}

model Thread {
  id        String         @id @default(cuid())
  jobId     String?
  job       Job?           @relation(fields: [jobId], references: [id])
  members   ThreadMember[]
  messages  Message[]
  lastMessageAt DateTime   @default(now())
  createdAt DateTime       @default(now())

  @@index([lastMessageAt])
}

model ThreadMember {
  threadId String
  thread   Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime?

  @@id([threadId, userId])
  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  threadId   String
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  body       String   @db.Text

  // Deliverables arrive watermarked; the clean original stays unreadable
  // until the milestone it belongs to is released.
  attachmentUrl   String?
  cleanUrl        String?
  watermarked     Boolean @default(false)
  releasedAt      DateTime?

  createdAt  DateTime @default(now())

  @@index([threadId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  jobId     String
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectId String
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id])
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  // One review per person per job — the deterministic pair is what stops
  // brigading.
  @@unique([jobId, authorId])
  @@index([subjectId, createdAt])
}

/**
 * A startup asking the marketplace to fund it.
 *
 * All-or-nothing, deliberately. Pledges sit in escrow and reach the founder
 * only if the goal is met by the deadline; otherwise every one is refunded in
 * full. Partial funding is how a backer ends up paying for a third of a thing
 * that then does not get built, and the escrow this platform already runs for
 * job milestones is exactly the mechanism that prevents it.
 *
 * **This is not equity.** Backers get no shares, no dividend and no claim on
 * the company — see `src/server/services/raises.ts`. Selling a stake in a
 * company to the public is a securities offering, regulated in every
 * jurisdiction this operates in, and nothing in this schema is capable of
 * representing one.
 */
model Raise {
  id            String      @id @default(cuid())
  founderId     String
  founder       User        @relation("RaiseFounder", fields: [founderId], references: [id])

  title         String
  /** The pitch, in the founder's words. */
  summary       String      @db.Text
  category      String
  /** "IDEA" | "PROTOTYPE" | "LAUNCHED" | "REVENUE" — how far along they are. */
  stage         String
  /** What the money is for, as a list of {label, amountCents}. Must sum to the
   *  goal, the same rule job milestones follow. */
  useOfFunds    Json
  /** What exists today. Kept separate from the pitch so a reader can find the
   *  facts without reading the ambition. */
  traction      String?     @db.Text
  websiteUrl    String?

  goalCents     Int
  /** Denormalised sum of HELD and RELEASED pledges. */
  raisedCents   Int         @default(0)
  backersCount  Int         @default(0)
  minPledgeCents Int        @default(1000)
  deadline      DateTime

  status        RaiseStatus @default(OPEN)
  settledAt     DateTime?

  pledges       Pledge[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, deadline])
  @@index([founderId])
  @@index([category, status])
}

/**
 * One backer's commitment.
 *
 * One per person per raise, so a backer's total is a single number they can
 * see and change rather than a pile of rows nobody can reconcile.
 */
model Pledge {
  id          String       @id @default(cuid())
  raiseId     String
  raise       Raise        @relation(fields: [raiseId], references: [id], onDelete: Cascade)
  backerId    String
  backer      User         @relation("PledgeBacker", fields: [backerId], references: [id])

  amountCents Int
  /**
   * How much of it came out of the posting balance rather than the wallet.
   *
   * Recorded because a refund has to go back where the money came from. A
   * client's posting balance is what funds escrow when they hire; refunding it
   * into the wallet would leave them unable to hire with their own money and
   * unable to explain where it went.
   */
  fromPostingCents Int      @default(0)
  status      PledgeStatus @default(HELD)
  /** A note to the founder. Readable by the founder and the backer, nobody
   *  else — the same rule proposals follow. */
  note        String?      @db.Text
  /** Show the amount publicly, or only that somebody backed it. */
  anonymous   Boolean      @default(false)

  createdAt   DateTime     @default(now())
  settledAt   DateTime?

  @@unique([raiseId, backerId])
  @@index([backerId, createdAt])
  @@index([raiseId, status])
}

/**
 * How a piece of writing arrived: typed here, or pasted from somewhere else.
 *
 * A separate table rather than columns on Profile, Job and Proposal, because
 * the three of them want identical fields and a fourth will want them too.
 *
 * `score` is the stylometric model's output and is deliberately not shown on
 * its own anywhere — see src/lib/authorship/index.ts for why a percentage is
 * the wrong thing to put next to somebody's writing, and why nothing in this
 * table is allowed to affect matching, ranking or eligibility.
 */
model ContentSignal {
  id        String   @id @default(cuid())
  /** "PROFILE_BIO" | "JOB_DESCRIPTION" | "PROPOSAL_NOTE" */
  kind      String
  /** The id of the row this describes. */
  refId     String
  /** "TYPED" | "PASTED" | "REVIEW" | "UNKNOWN" */
  band      String
  score     Int      @default(0)
  /** The sentences shown to a reader. Stored so the note next to a text does
   *  not change meaning when the model is retuned. */
  reasons   String[]
  /** Counts only — never keystrokes, never clipboard contents. */
  typed     Int      @default(0)
  pasted    Int      @default(0)
  words     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, refId])
  @@index([band])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}
